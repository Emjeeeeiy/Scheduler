rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Every document this app writes lives under the owner's uid, so one rule
    // covers tasks, tags, and anything added later. A signed-in user can reach
    // their own subtree and nothing else; there is no cross-user read path.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Anything outside /users is not part of this app. Deny by default rather
    // than leaving a hole for a future collection to fall through.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
