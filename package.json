{
  "name": "cadence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "icons": "node scripts/makeIcons.mjs",
    "icons:mobile": "node scripts/makeMobileAssets.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:functions": "npm --prefix functions test",
    "test:dom": "vitest run",
    "test:render": "vite build --config tests/smoke/vite.config.js && node node_modules/.smoke/entry.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cadence/shared": "0.1.0",
    "@google/genai": "^2.21.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@upstash/redis": "^1.41.0",
    "firebase": "^12.8.0",
    "jose": "^6.2.11",
    "perfect-freehand": "1.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
