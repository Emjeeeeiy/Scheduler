{
  "name": "cadence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "icons": "node scripts/makeIcons.mjs",
    "icons:mobile": "node scripts/makeMobileAssets.mjs",
    "mcp:dev": "node --env-file-if-exists=.env.local scripts/mcp-dev.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:functions": "npm --prefix functions test",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-cadence-rules \"node --test tests/rules/firestoreRules.spec.mjs\"",
    "test:dom": "vitest run",
    "test:render": "vite build --config tests/smoke/vite.config.js && node node_modules/.smoke/entry.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cadence/shared": "0.1.0",
    "@google/genai": "^2.21.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-highlight": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-subscript": "3.34.0",
    "@tiptap/extension-superscript": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/extension-text-style": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@upstash/redis": "^1.41.0",
    "firebase": "^12.8.0",
    "firebase-admin": "^14.5.1",
    "jose": "^6.2.17",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}
