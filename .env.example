# Copy this file to `.env.local` and paste the values from your Firebase project:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration
#
# These values are NOT secrets. The Firebase web config ships inside the client
# bundle by design and is safe to expose. `firestore.rules` is the actual
# security boundary — publish it before putting real data in.
#
# Vite only exposes variables prefixed with VITE_, and it reads .env.local at
# server start, so restart `npm run dev` after editing.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --------------------------------------------------------------------------
# Phase 7's AI layer (api/) — the auto-tag / plan-my-day / quick-add
# enhancements, backed by Gemini's free tier. Deliberately NOT VITE_-prefixed:
# these are read only by the api/*.js serverless functions and must never
# reach the client bundle. Set the real values in Vercel's dashboard
# (Project Settings -> Environment Variables) for Production/Preview/
# Development; only put them here for `vercel dev` locally.
#
# The heuristics in src/lib/ (parseQuickAdd.js, suggestTag.js, planDay in
# autoSchedule.js) work with none of this set — every one of these is an
# enhancement layer on top of something that already works, never a
# replacement. Leaving these blank just means the AI half stays off.

# Google AI Studio -> Get API key. Free tier: Google uses this content to
# improve their products — accepted deliberately, see the Phase 7 plan.
GEMINI_API_KEY=

# The SAME value as VITE_FIREBASE_PROJECT_ID above, deliberately duplicated
# under its own, non-VITE_-prefixed name. api/_lib/auth.js needs the project
# id to verify a Firebase ID token, and reading the VITE_-prefixed copy from
# a serverless function turned out not to work under `vercel dev` — that
# prefix is a client-build-time convention, and this endpoint is server-side.
FIREBASE_PROJECT_ID=

# Model ids are env-configurable because Gemini's naming churns — confirm
# what your key actually has access to in AI Studio before deploying. This
# already happened once: gemini-2.5-flash-lite (the original default here)
# was retired for new API keys shortly after this was written, discovered
# via the exact 404 Gemini's own API returns when a model id is gone —
# leave GEMINI_MODEL_FAST/_PLAN unset unless your key needs a different one.
# Fast/cheap model for tagging and quick-add parsing.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# A step up for "Plan my day" — the one call that's actually asked to
# reason, not just classify or extract.
GEMINI_MODEL_PLAN=gemini-3.5-flash
