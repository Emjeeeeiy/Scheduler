# Copy this file to `.env.local` and paste the values from your Firebase project:
#   Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration
#
# These values are NOT secrets. The Firebase web config ships inside the client
# bundle by design and is safe to expose. `firestore.rules` is the actual
# security boundary — publish it before putting real data in.
#
# Vite only exposes variables prefixed with VITE_, and it reads .env.local at
# server start, so restart `npm run dev` after editing.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed for push notifications (Phase 6, functions/). Also not a
# secret — a VAPID public key is meant to travel with the client the same
# way the rest of this file does. Firebase console -> Project settings ->
# Cloud Messaging -> Web Push certificates -> generate a key pair.
# See README-functions.md before this does anything: it needs the Cloud
# Functions in functions/ actually deployed too, not just this key set.
VITE_FIREBASE_VAPID_KEY=
